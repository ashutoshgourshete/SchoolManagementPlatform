# ===================================================================
# School & College Management SaaS Platform Environment Configuration
# ===================================================================

# Database Connection (SQL Server)
# Local: Server=(localdb)\MSSQLLocalDB;Database=SchoolManagementSaaS_Dev;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True
# Production: Server=tcp:your-server.database.windows.net,1433;Initial Catalog=EduManage_Prod;Persist Security Info=False;User ID=cloudadmin;Password=YourSecurePassword123!;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;
ConnectionStrings__DefaultConnection="Server=(localdb)\\MSSQLLocalDB;Database=SchoolManagementSaaS_Dev;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"

# JWT Authentication
JwtSettings__SecretKey="SchoolManagementPlatformSuperSecretKey2026!#*123456789"
JwtSettings__Issuer="SchoolManagementPlatform"
JwtSettings__Audience="SchoolManagementPlatformClient"
JwtSettings__ExpiryMinutes=120
JwtSettings__RefreshTokenExpiryDays=7

# CORS Allowed Origins (Comma-separated in production)
CorsOrigins__0="http://localhost:4200"
CorsOrigins__1="https://app.edumanage.com"

# Payment Gateways (Optional - Set AllowUnsignedWebhooksInDev to false in production)
PaymentGateways__AllowUnsignedWebhooksInDev=true
PaymentGateways__Razorpay__KeyId="rzp_test_placeholder_key"
PaymentGateways__Razorpay__KeySecret="rzp_test_placeholder_secret"
PaymentGateways__Razorpay__WebhookSecret="rzp_webhook_secret_key"

PaymentGateways__Stripe__PublishableKey="pk_test_placeholder_key"
PaymentGateways__Stripe__SecretKey="sk_test_placeholder_secret"
PaymentGateways__Stripe__WebhookSecret="whsec_placeholder_secret"

# Frontend Angular API Endpoint
# In production, reverse-proxy /api or set https://api.edumanage.com/api/v1
ANGULAR_API_URL="http://localhost:5000/api/v1"
